# =============================================
#  VentureConnect RAG Service — Environment
# =============================================
#
# Copy this file to .env and fill in your values.
# All variables are prefixed with RAG_
#

# --- LLM Provider (groq | openai | anthropic | mock) ---
# "mock" works without an API key — use it for local testing
RAG_LLM_PROVIDER=groq
RAG_LLM_MODEL=llama-3.3-70b-versatile
RAG_LLM_API_KEY=your_groq_api_key_here

# For OpenAI-compatible endpoints (optional)
RAG_LLM_API_BASE=

# --- Embeddings ---
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- ChromaDB ---
RAG_CHROMA_PERSIST_DIR=./chroma_db
RAG_CHROMA_COLLECTION=ventureconnect_docs

# --- Chunking ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# --- Retrieval ---
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.35

# --- Security (must match Spring Boot application.properties) ---
RAG_INTERNAL_API_KEY=vc-internal-secret-key-2024

# --- Upload limits ---
RAG_MAX_FILE_SIZE_MB=50
